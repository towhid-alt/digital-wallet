// use prisma-8
enum AccountType {
  ACTIVE
  FROZEN
  CLOSED
}

enum Status {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OweStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID
}

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  username  String?
  password  String?
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
}


model Account {
  id        Int           @id@default(autoincrement())
  userId    Int
  type      AccountType   @default(ACTIVE)
  createdAt DateTime      @default(now())    
  user      User          @relation(fields: [userId], references: [id])
}

model transaction {
  id              Int         @id@default(autoincrement())
  fromAccount     Int     
  toAccount       Int
  status          Status      @default(PENDING)
  amount          Float
  from            Account     @relation(fields: [fromAccount], references: [id])
  to              Account     @relation(fields: [toAccount], references: [id])
  idempotencyKey  String      @unique
  createdAt       DateTime    @default(now())
}

model ledger {
  id              Int               @id@default(autoincrement())
  account         Int
  accountRel      Account           @relation(fields: [account], references: [id])
  amount          Float       
  transaction     Int
  transactionR    transaction       @relation(fields: [transaction], references: [id])
  type            TransactionType   
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     RequestStatus       @default(PENDING)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @onUpdate(now())

  sender     User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Owes {
  id            Int                 @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  amount        Int
  detail        Text
  status        OweStatus           @default(PENDING)
  createdAt     DateTime            @default(now())

  sender        User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User                @relation(fields: [receiverId], references: [id], onDelete: Cascade)
}
